[debug] [2026-06-26T05:18:03.980Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/cot-ministries-da557/rulesets {"name":"projects/cot-ministries-da557/rulesets/bfa3f75b-5e84-46e7-b3db-296a696f6814","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Helper functions for authentication and permissions\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n    \r\n    function isAdmin() {\r\n      return isAuthenticated() && \r\n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';\r\n    }\r\n    \r\n    function hasPermission(permission) {\r\n      return isAuthenticated() && (\r\n        isAdmin() || \r\n        get(/databases/$(database)/documents/communicationPermissions/$(request.auth.uid)).data.permissions[permission] == true\r\n      );\r\n    }\r\n    \r\n    function isOwner(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n    \r\n    // Announcements Collection\r\n    match /announcements/{announcementId} {\r\n      // Create: requires 'Create Announcements' permission\r\n      allow create: if hasPermission('createAnnouncements');\r\n      \r\n      // Read: requires any communication permission or admin role\r\n      allow read: if hasPermission('createAnnouncements') || \r\n                     hasPermission('sendAnnouncements') || \r\n                     hasPermission('manageContactLists');\r\n      \r\n      // Update: requires 'Send Announcements' permission (for status updates)\r\n      // Only creator or admin can update draft announcements\r\n      allow update: if hasPermission('sendAnnouncements') && \r\n                      (isAdmin() || resource.data.createdBy == request.auth.uid);\r\n      \r\n      // Delete: only admin or creator can delete\r\n      allow delete: if isAdmin() || \r\n                      (hasPermission('createAnnouncements') && resource.data.createdBy == request.auth.uid);\r\n    }\r\n    \r\n    // Contact Lists Collection\r\n    match /contactLists/{listId} {\r\n      // Requires 'Manage Contact Lists' permission for all operations\r\n      allow create: if hasPermission('manageContactLists');\r\n      allow read: if hasPermission('manageContactLists') || \r\n                     hasPermission('createAnnouncements') || \r\n                     hasPermission('sendAnnouncements');\r\n      allow update: if hasPermission('manageContactLists');\r\n      allow delete: if hasPermission('manageContactLists') && \r\n                      (isAdmin() || resource.data.createdBy == request.auth.uid);\r\n    }\r\n    \r\n    // Contacts Collection\r\n    match /contacts/{contactId} {\r\n      // Requires 'Manage Contact Lists' permission for all operations\r\n      allow create: if hasPermission('manageContactLists');\r\n      allow read: if hasPermission('manageContactLists') || \r\n                     hasPermission('createAnnouncements') || \r\n                     hasPermission('sendAnnouncements');\r\n      allow update: if hasPermission('manageContactLists');\r\n      allow delete: if hasPermission('manageContactLists');\r\n    }\r\n    \r\n    // Delivery Records Collection (Read-only for clients, server writes only)\r\n    match /deliveryRecords/{recordId} {\r\n      // Read: requires any communication permission\r\n      allow read: if hasPermission('createAnnouncements') || \r\n                     hasPermission('sendAnnouncements') || \r\n                     hasPermission('manageContactLists');\r\n      \r\n      // Write: blocked for clients, only server/admin SDK can write\r\n      allow create, update, delete: if false;\r\n    }\r\n    \r\n    // Communication Permissions Collection\r\n    match /communicationPermissions/{userId} {\r\n      // Read: users can read their own permissions, admins can read all\r\n      allow read: if isOwner(userId) || isAdmin();\r\n      \r\n      // Write: only admins can modify permissions\r\n      allow create, update, delete: if isAdmin();\r\n    }\r\n    \r\n    // Communication Audit Log Collection\r\n    match /communicationAuditLog/{logId} {\r\n      // Read: only admins can view audit logs\r\n      allow read: if isAdmin();\r\n      \r\n      // Write: blocked for clients, only server writes\r\n      allow create: if false;\r\n      allow update, delete: if false;\r\n    }\r\n    \r\n    // Fallback rule for other collections (preserving existing permissive rules)\r\n    match /{document=**} {\r\n      // WARNING: This rule allows anyone with your database ID to read and write\r\n      // to your database. This is intended for development purposes only.\r\n      // We've extended the access until Feb 2027.\r\n      allow read, write: if request.time < timestamp.date(2027, 2, 21);\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-06-26T05:18:03.884143Z","metadata":{"services":["cloud.firestore"]}}
