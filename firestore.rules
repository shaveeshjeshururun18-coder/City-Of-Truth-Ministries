rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // WARNING: This rule allows anyone with your database ID to read and write
      // to your database. This is intended for development purposes only.
      // We've extended the access until Feb 2027.
      allow read, write: if request.time < timestamp.date(2027, 2, 21);
    }
  }
}
