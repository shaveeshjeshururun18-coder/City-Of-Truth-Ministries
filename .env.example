# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ==============================================================================
# AI SERVICES
# ==============================================================================

# Gemini API Key (optional - for legacy service)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API Key (for COT AI Assistant)
# Get your key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here

# ==============================================================================
# ADMIN ACCESS
# ==============================================================================

# Admin Dashboard Password
VITE_ADMIN_PASSWORD=your-secure-admin-password

# Admin Password Change Phrase
VITE_ADMIN_PASSWORD_CHANGE_PHRASE=your-admin-password-change-phrase

# System Reboot Password
VITE_REBOOT_PASSWORD=your-reboot-password

# ==============================================================================
# DEPLOYMENT
# ==============================================================================

# Vercel Deployment Token (optional - for CI/CD)
VERCEL_TOKEN=your-vercel-token-here

# ==============================================================================
# ADVANCED COMMUNICATION SYSTEM (Optional - only if using communication features)
# ==============================================================================

# ------------------------------------------------------------------------------
# Twilio SMS Configuration
# ------------------------------------------------------------------------------
# Required for SMS notifications feature
# Get your credentials from: https://console.twilio.com
# 
# Steps:
# 1. Sign up at https://www.twilio.com/try-twilio
# 2. Get Account SID and Auth Token from console dashboard
# 3. Get or purchase a phone number with SMS capability
# 4. For trial accounts: Verify recipient phone numbers in console

VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_AUTH_TOKEN=your_32_character_auth_token_here
VITE_TWILIO_PHONE_NUMBER=+12345678901

# ------------------------------------------------------------------------------
# EmailJS Configuration
# ------------------------------------------------------------------------------
# Required for email announcements feature
# Get your credentials from: https://dashboard.emailjs.com
#
# Steps:
# 1. Sign up at https://www.emailjs.com
# 2. Connect your email service (Gmail, Outlook, etc.)
# 3. Create an email template for announcements
# 4. Get Service ID, Template ID, and Public Key from dashboard

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# ------------------------------------------------------------------------------
# Communication Feature Flags
# ------------------------------------------------------------------------------
# Control communication system behavior

# Enable/disable SMS functionality (true/false)
VITE_ENABLE_SMS=false

# SMS sending rate limit (messages per second)
# Recommended: 1 for trial accounts, 5 for standard, 10 for high-volume
VITE_SMS_RATE_LIMIT=5

# Maximum SMS recipients per send operation (max: 500)
VITE_MAX_SMS_RECIPIENTS=500

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) Configuration
# ------------------------------------------------------------------------------
# Required for Web Push notifications
# Get VAPID Key from: Firebase Console -> Settings -> Cloud Messaging -> Web Push Certificates
VITE_FCM_VAPID_KEY=your_fcm_vapid_public_key_here

# Required for sending push notifications client-side (Legacy server key)
# Get Server Key from: Firebase Console -> Settings -> Cloud Messaging -> Cloud Messaging API (Legacy)
VITE_FCM_SERVER_KEY=your_fcm_legacy_server_key_here

# ==============================================================================
# NOTES
# ==============================================================================
# 
# - Create .env.local from this template and add your actual values
# - Never commit .env.local or real credentials to version control
# - Use different credentials for development, staging, and production
# - See COMMUNICATION_SETUP.md for detailed configuration instructions
# - All VITE_* variables are exposed to the client-side code
# - Keep sensitive tokens (like Twilio Auth Token) secure
#
